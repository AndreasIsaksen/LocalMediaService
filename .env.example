# Copy this file to .env and replace both secrets before starting the stack.
MEDIA_PATH=/mnt/local-media
LOCAL_MEDIA_BIND=0.0.0.0
LOCAL_MEDIA_PORT=8092
# Hostname or IP clients use to open the portal; Caddy puts it in the local TLS certificate.
LOCAL_MEDIA_HOST=10.230.1.208
TZ=Europe/Oslo

LMS_ADMIN_USERNAME=admin
LMS_ADMIN_PASSWORD=replace-with-a-long-unique-password
# Generate with: openssl rand -base64 32
LMS_CREDENTIAL_KEY=replace-with-a-base64-encoded-32-byte-key

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MediaLibrary": {
    "RootPath": "/media",
    "MountSentinelFile": ".local-media-volume",
    "ScanIntervalSeconds": 30
  },
  "Storage": {
    "DataPath": "/data"
  },
  "PortalSecurity": {
    "AdminUsername": "admin",
    "AdminPassword": "",
    "RequireHttps": true
  },
  "ReverseProxy": {
    "TrustForwardedHeaders": false
  },
  "CredentialStore": {
    "EncryptionKey": ""
  },
